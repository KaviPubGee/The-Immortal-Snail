  m_Name: 
  m_EditorClassIdentifier: 
  playerFollowMouse: {fileID: 2115040985}
  saltSpawner: {fileID: 0}
  dialogueText: {fileID: 146777032}
  typeWriter: {fileID: 1083960699}
  dialogueCanvas: {fileID: 1543461252}
  typeSpeed: 0.04
  dialogueLines:
  - Ah... so this is where we meet. A kitchen floor... wooden walls all around us.
    Still no way out. Just you and I, trapped together...
  - My touch is death to you. One small brush of my slime against your skin, and
    everything you are ends forever...
  - You could crush me right now. End my long, long existence with a single touch.
    But will you dare? Or will you stand there, watching me crawl across this floor,
    inch by inch, getting closer?
